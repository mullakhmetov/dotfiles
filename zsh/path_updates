path=("$HOME/.local/bin" "$HOME/.zsh/shell_scripts" $path)
export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
[[ -d "$PYENV_ROOT/bin" ]] && path=("$PYENV_ROOT/bin" $path)

if command -v pyenv &>/dev/null; then
    pyenv() {
        unfunction pyenv
        eval "$(command pyenv init -)"
        pyenv "$@"
    }
fi

export GOPATH="${GOPATH:-$HOME/Workspace/golang}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
export GOPROXY="${GOPROXY:-direct}"
export GOTOOLCHAIN=auto
path+=("$GOBIN")

if [[ "$OSTYPE" == darwin* && -n "$HOMEBREW_PREFIX" ]]; then
    for directory in "$HOMEBREW_PREFIX/opt/grep/libexec/gnubin" \
        "$HOMEBREW_PREFIX/opt/libpq/bin" \
        "$HOMEBREW_PREFIX/opt/mysql-client@8.0/bin"; do
        [[ -d "$directory" ]] && path=("$directory" $path)
    done
fi
export PATH
